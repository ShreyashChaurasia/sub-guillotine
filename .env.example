# ============================================================
# SUB GUILLOTINE — ENVIRONMENT CONFIGURATION
# ============================================================

# AWS Bedrock Credentials
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1

# Amazon Bedrock Model ID
# Recommended: anthropic.claude-3-5-sonnet-20241022-v2:0
# Alternative: amazon.nova-pro-v1:0 or anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Application & Storage Settings
DATABASE_PATH=sub_guillotine.db
SCREENSHOTS_DIR=screenshots
DEADLINE_THRESHOLD_HOURS=24

# Mock SaaS Environment
MOCK_PORTAL_HOST=127.0.0.1
MOCK_PORTAL_PORT=8888
MOCK_PORTAL_URL=http://localhost:8888
HEADLESS_BROWSER=true

# HITL Notification Mode (cli | telegram)
HITL_MODE=cli
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
